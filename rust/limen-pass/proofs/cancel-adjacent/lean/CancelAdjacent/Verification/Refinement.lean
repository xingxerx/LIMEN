/-
CancelAdjacent.Verification.Refinement (Nov 25, 2026)

The Rust function `limen_pass.cancel_adjacent` (Extraction/Funs.lean, generated by
Aeneas from rust/limen-pass/src/lib.rs) computes exactly the model
`CancelSpec.cancel` (Spec.lean), given a `clone` that returns its argument and a
`cancels` that answers with a plain function `c`. So the four claims proven about
the model in Spec.lean hold for the shipped Rust code.

Not imported by the library root yet. Check it with the xing-pc preset
`limen_lean_refine`.

Proof note: in hax, `Vec T` reduces to `Seq T`, which is `Slice T` only by an ordinary
definition. A bind whose value has one of these types and whose binder has another is
not simplified by `simp`, so each library step below is stated with an opaque result of
the exact Rust type (`vec_*_ok`), and `bind_ok_vec` handles the one `ok out` deref.
-/
import CancelAdjacent.Extraction
import CancelAdjacent.Verification.Spec

open CoreModels Aeneas
open Aeneas.Std hiding namespace core alloc
open RustM ControlFlow

namespace CancelRefine

variable {T : Type}

/-! ## The model, rewritten in circuit order (oldest first), the way the Rust stores it -/

/-- One step on the output list as the Rust keeps it: newest item last. -/
def stepOut (c : T → T → Bool) (out : List T) (x : T) : List T :=
  match out.getLast? with
  | some top => if c top x then out.dropLast else out ++ [x]
  | none => [x]

theorem stepOut_reverse (c : T → T → Bool) (st : List T) (x : T) :
    stepOut c st.reverse x = (CancelSpec.step c st x).reverse := by
  cases st with
  | nil => simp [stepOut, CancelSpec.step]
  | cons top rest =>
    cases h : c top x <;> simp [stepOut, CancelSpec.step, h]

theorem foldl_stepOut (c : T → T → Bool) (xs st : List T) :
    xs.foldl (stepOut c) st.reverse = (xs.foldl (CancelSpec.step c) st).reverse := by
  induction xs generalizing st with
  | nil => simp
  | cons x xs ih =>
    simp only [List.foldl_cons]
    rw [stepOut_reverse, ih]

/-- The model equals a left fold of `stepOut` from the empty output. -/
theorem cancel_eq_foldl (c : T → T → Bool) (xs : List T) :
    CancelSpec.cancel c xs = xs.foldl (stepOut c) [] := by
  have h := foldl_stepOut c xs []
  simpa [CancelSpec.cancel, CancelSpec.cancelStack] using h.symm

theorem stepOut_length_le (c : T → T → Bool) (out : List T) (x : T) :
    (stepOut c out x).length ≤ out.length + 1 := by
  unfold stepOut
  split
  · split
    · simp; omega
    · simp
  · simp

theorem foldl_stepOut_length_le (c : T → T → Bool) (xs out : List T) :
    (xs.foldl (stepOut c) out).length ≤ out.length + xs.length := by
  induction xs generalizing out with
  | nil => simp
  | cons x xs ih =>
    simp only [List.foldl_cons, List.length_cons]
    have := ih (stepOut c out x)
    have := stepOut_length_le c out x
    omega

/-! ## The library steps the loop body uses, each with a result of the exact Rust type -/

theorem usize_add_ok (x y : Std.Usize) (h : x.val + y.val ≤ Usize.max) :
    ∃ z : Std.Usize, x + y = ok z ∧ z.val = x.val + y.val := by
  have he := UScalar.add_equiv x y
  split at he
  · rename_i z hz
    exact ⟨z, RustM.match.isOk.mp hz, he.2.1⟩
  · exfalso
    have h2 := he.2
    simp only [UScalar.inBounds] at h2
    scalar_tac
  · exact he.elim

theorem usize_sub_ok (x y : Std.Usize) (h : y.val ≤ x.val) :
    ∃ z : Std.Usize, x - y = ok z ∧ z.val = x.val - y.val := by
  have he := UScalar.sub_equiv x y
  split at he
  · rename_i z hz
    refine ⟨z, RustM.match.isOk.mp hz, ?_⟩
    scalar_tac
  · exfalso
    scalar_tac
  · exact he.elim

theorem vec_len_ok (out : alloc.vec.Vec T) : alloc.vec.Vec.len out = ok (Slice.len out) := rfl

theorem bind_ok_vec {β : Type} (out : alloc.vec.Vec T) (f : Slice T → RustM β) :
    (do let x ← (ok out : RustM (Slice T)); f x) = f out :=
  bind_tc_ok out f

theorem vec_new_ok : ∃ v : alloc.vec.Vec T, alloc.vec.Vec.new T = ok v ∧ v.val = [] :=
  ⟨Slice.new T, by simp [alloc.vec.Vec.new, rust_primitives.sequence.seq_empty],
    Slice.new_val T⟩

theorem vec_index_ok (out : alloc.vec.Vec T) (m : Std.Usize) (hml : m.val < out.val.length) :
    alloc.vec.Vec.Insts.CoreOpsIndexIndex.index (core.Usize.Insts.CoreSliceIndexSliceIndexSliceT T)
      out m = ok (out.val[m.val]'hml) := by
  have hget : out.val[m.val]? = some (out.val[m.val]'hml) := List.getElem?_eq_getElem hml
  have h2 : ∀ s : Slice T, s.val = out.val → s[m]? = some (out.val[m.val]'hml) := by
    intro s hs
    rw [Slice.getElem?_Usize_eq, hs]
    exact hget
  simp only [alloc.vec.Vec.Insts.CoreOpsIndexIndex.index,
    alloc.vec.Vec.Insts.CoreOpsDerefDerefSlice.deref, alloc.vec.Vec.as_slice,
    rust_primitives.sequence.seq_to_slice]
  rw [bind_ok_vec]
  simp [core.Slice.Insts.CoreOpsIndexIndex.index, core.Usize.Insts.CoreSliceIndexSliceIndexSliceT.get,
    rust_primitives.slice.slice_length, rust_primitives.slice.slice_index, Slice.index_usize, hml]
  rw [h2 out rfl]

theorem vec_push_ok (out : alloc.vec.Vec T) (x : T) (h : out.val.length < Usize.max) :
    ∃ v : alloc.vec.Vec T, alloc.vec.Vec.push out x = ok v ∧ v.val = out.val ++ [x] := by
  simp [alloc.vec.Vec.push, rust_primitives.sequence.seq_push, h]
  exact ⟨_, rfl, Slice.from_val _ _⟩

theorem vec_pop_ok (out : alloc.vec.Vec T) (h : 0 < out.val.length) :
    ∃ t v, alloc.vec.Vec.pop out = ok (core.option.Option.Some t, v) ∧ v.val = out.val.dropLast := by
  obtain ⟨m, hm, hmv⟩ := usize_sub_ok (Slice.len out) 1#usize (by scalar_tac)
  have hmv' : m.val = out.val.length - 1 := by scalar_tac
  have hml : m.val < out.val.length := by scalar_tac
  have hdrop : List.take m.val out.val ++ List.drop (m.val + 1) out.val = out.val.dropLast := by
    rw [List.dropLast_eq_take, ← hmv', show m.val + 1 = out.val.length by omega,
      List.drop_length, List.append_nil]
  simp [alloc.vec.Vec.pop, rust_primitives.sequence.seq_len, hm, rust_primitives.sequence.seq_remove,
    hml, h, hdrop]
  exact ⟨_, _, rfl, Slice.from_val _ _⟩

/-! ## One turn of the Rust loop -/

/-- Inside the bounds, one turn does exactly `stepOut` and moves to the next index. -/
theorem body_step
    (cl : core.clone.Clone T) (cn : limen_pass.Cancels T) (c : T → T → Bool)
    (hcl : ∀ x, cl.clone x = ok x) (hcn : ∀ a b, cn.cancels a b = ok (c a b))
    (ops : Slice T) (out : alloc.vec.Vec T) (i : Std.Usize)
    (hi : i.val < ops.val.length) (hout : out.val.length ≤ i.val) :
    ∃ out' i', limen_pass.cancel_adjacent_loop.body cl cn ops out i = ok (cont (out', i'))
      ∧ out'.val = stepOut c out.val (ops.val[i.val]'hi)
      ∧ i'.val = i.val + 1 := by
  have hops := ops.property
  obtain ⟨j, hj, hjv⟩ := usize_add_ok i 1#usize (by scalar_tac)
  have hj1 : j.val = i.val + 1 := by scalar_tac
  have hlt : out.val.length < Usize.max := by scalar_tac
  obtain ⟨w, hpush, hw⟩ := vec_push_ok out (ops.val[i.val]'hi) hlt
  unfold limen_pass.cancel_adjacent_loop.body
  by_cases hn : 0 < out.val.length
  · obtain ⟨m, hm, hmv⟩ := usize_sub_ok (Slice.len out) 1#usize (by scalar_tac)
    have hmv' : m.val = out.val.length - 1 := by scalar_tac
    have hml : m.val < out.val.length := by scalar_tac
    have hidx := vec_index_ok out m hml
    obtain ⟨t, v, hpop, hv⟩ := vec_pop_ok out hn
    have hlast : out.val.getLast? = some (out.val[m.val]'hml) := by
      have hget : out.val[m.val]? = some (out.val[m.val]'hml) := List.getElem?_eq_getElem hml
      rw [List.getLast?_eq_getElem?, ← hmv', hget]
    simp [core.slice.Slice.len, rust_primitives.slice.slice_length, hi, Slice.index_usize,
      vec_len_ok, hcl, hcn, hj, hm, hn, hidx, hpop, hpush]
    by_cases hc : c (out.val[m.val]'hml) (ops.val[i.val]'hi) = true
    · simp [hc, stepOut, hlast, hv, hj1]
    · simp [hc, stepOut, hlast, hw, hj1]
  · have he : out.val = [] := List.eq_nil_of_length_eq_zero (by omega)
    simp [core.slice.Slice.len, rust_primitives.slice.slice_length, hi, Slice.index_usize,
      vec_len_ok, hcl, hcn, hj, hpush, stepOut, he, hw, hj1]

/-- Past the end, the loop stops and returns what it has. -/
theorem body_done
    (cl : core.clone.Clone T) (cn : limen_pass.Cancels T)
    (ops : Slice T) (out : alloc.vec.Vec T) (i : Std.Usize)
    (hi : ¬ i.val < ops.val.length) :
    limen_pass.cancel_adjacent_loop.body cl cn ops out i = ok (done out) := by
  unfold limen_pass.cancel_adjacent_loop.body
  simp [core.slice.Slice.len, rust_primitives.slice.slice_length, hi]

/-! ## The whole loop, by induction on how many gates are left -/

theorem loop_spec
    (cl : core.clone.Clone T) (cn : limen_pass.Cancels T) (c : T → T → Bool)
    (hcl : ∀ x, cl.clone x = ok x) (hcn : ∀ a b, cn.cancels a b = ok (c a b))
    (ops : Slice T) :
    ∀ (k : Nat) (out : alloc.vec.Vec T) (i : Std.Usize),
      ops.val.length - i.val = k → i.val ≤ ops.val.length →
      out.val = (ops.val.take i.val).foldl (stepOut c) [] →
      ∃ v, limen_pass.cancel_adjacent_loop cl cn ops out i = ok v
        ∧ v.val = ops.val.foldl (stepOut c) [] := by
  intro k
  induction k with
  | zero =>
    intro out i hk hle hout
    have hend : ¬ i.val < ops.val.length := by omega
    refine ⟨out, ?_, ?_⟩
    · rw [limen_pass.cancel_adjacent_loop, Std.loop]
      simp [body_done cl cn ops out i hend]
    · have : i.val = ops.val.length := by omega
      simpa [this] using hout
  | succ k ih =>
    intro out i hk hle hout
    have hi : i.val < ops.val.length := by omega
    have hlen : out.val.length ≤ i.val := by
      have := foldl_stepOut_length_le c (ops.val.take i.val) []
      simp at this
      rw [hout]; omega
    obtain ⟨out', i', hb, hout', hi'⟩ := body_step cl cn c hcl hcn ops out i hi hlen
    obtain ⟨v, hv, hvv⟩ := ih out' i' (by omega) (by omega) (by
      rw [hout', hout, hi', List.take_succ_eq_append_getElem hi, List.foldl_append]
      simp)
    refine ⟨v, ?_, hvv⟩
    rw [limen_pass.cancel_adjacent_loop, Std.loop]
    simp [hb]
    simpa [limen_pass.cancel_adjacent_loop] using hv

/-! ## The headline theorem -/

/-- The Rust `cancel_adjacent` succeeds and returns exactly the model's output. -/
theorem cancel_adjacent_refines
    (cl : core.clone.Clone T) (cn : limen_pass.Cancels T) (c : T → T → Bool)
    (hcl : ∀ x, cl.clone x = ok x) (hcn : ∀ a b, cn.cancels a b = ok (c a b))
    (ops : Slice T) :
    ∃ v, limen_pass.cancel_adjacent cl cn ops = ok v
      ∧ v.val = CancelSpec.cancel c ops.val := by
  obtain ⟨v0, hnew, hv0⟩ := vec_new_ok (T := T)
  obtain ⟨v, hv, hvv⟩ := loop_spec cl cn c hcl hcn ops ops.val.length v0 0#usize
    (by simp) (by simp) (by simp [hv0])
  refine ⟨v, ?_, ?_⟩
  · unfold limen_pass.cancel_adjacent
    simp [hnew, hv]
  · rw [cancel_eq_foldl]
    exact hvv

end CancelRefine

#print axioms CancelRefine.cancel_adjacent_refines
