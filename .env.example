# Copy this file to .env and fill in the values you need.
# .env is gitignored — never commit real credentials.

# --- IBM Quantum Runtime ---
IBM_QUANTUM_TOKEN=
IBM_QUANTUM_CRN=

# --- D-Wave ---
DWAVE_API_TOKEN=
DWAVE_API_ENDPOINT=

# --- Open Quantum ---
OPENQUANTUM_CLIENT_ID=
OPENQUANTUM_CLIENT_SECRET=

# --- Azure Quantum (Atom Computing backend) ---
# Provide either AZURE_QUANTUM_CONNECTION_STRING, or both of
# AZURE_QUANTUM_RESOURCE_ID and AZURE_QUANTUM_LOCATION.
AZURE_QUANTUM_RESOURCE_ID=
AZURE_QUANTUM_LOCATION=
AZURE_QUANTUM_CONNECTION_STRING=

# --- LIMEN distributed node config ---
LIMEN_NODE_ID=
LIMEN_NODE_HOST=0.0.0.0
LIMEN_NODE_PORT=50051
LIMEN_NODE_DEVICE_IDS=
LIMEN_KNOWN_PEERS=
LIMEN_TLS_CERT=
LIMEN_TLS_KEY=
LIMEN_TLS_CA=
